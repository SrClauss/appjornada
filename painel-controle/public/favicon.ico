<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0F172A" />
      <stop offset="100%" stop-color="#020617" />
    </linearGradient>
    <linearGradient id="brandGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10B981" />
      <stop offset="100%" stop-color="#38BDF8" />
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#38BDF8" />
      <stop offset="100%" stop-color="#818CF8" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="12" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Background Card -->
  <rect width="512" height="512" rx="128" fill="url(#bgGrad)" />
  <rect width="504" height="504" x="4" y="4" rx="124" fill="none" stroke="url(#brandGrad)" stroke-width="8" stroke-opacity="0.3" />

  <!-- Speedometer Arc -->
  <path d="M 116 336 A 160 160 0 1 1 396 336" fill="none" stroke="url(#brandGrad)" stroke-width="28" stroke-linecap="round" filter="url(#glow)" />
  <path d="M 116 336 A 160 160 0 0 1 200 160" fill="none" stroke="#334155" stroke-width="28" stroke-linecap="round" />

  <!-- Outer Route Dots -->
  <circle cx="256" cy="116" r="14" fill="#10B981" />
  <circle cx="360" cy="160" r="14" fill="#38BDF8" />
  <circle cx="396" cy="256" r="14" fill="#818CF8" />

  <!-- Vehicle / Arrow Pointer Icon -->
  <g transform="translate(256, 260) rotate(45)">
    <path d="M 0 -85 L 60 75 L 0 40 L -60 75 Z" fill="url(#brandGrad)" filter="url(#glow)" />
  </g>

  <!-- Central Pulse Indicator -->
  <circle cx="256" cy="270" r="22" fill="#0F172A" stroke="url(#brandGrad)" stroke-width="8" />
  <circle cx="256" cy="270" r="8" fill="#10B981" />
</svg>
