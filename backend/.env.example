# Conexão MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=app_jornada

# JWT — troque SECRET_KEY por uma string longa e aleatória em produção
SECRET_KEY=troque-esta-chave-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# MinIO (para uploads de imagens)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=app-jornada
MINIO_SECURE=false

# CORS — origens separadas por vírgula
# Desenvolvimento: libere as origens do Vite e do React dev server
# Produção: substitua pelos domínios reais (ex: https://painel.suaempresa.com)
# Use "*" somente em desenvolvimento sem credenciais
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Coleta de telas Android — chave de acesso simples para o app de coleta
# O app Android deve enviar este valor no header: X-Api-Key
COLETA_API_KEY=troque-esta-chave-coleta
